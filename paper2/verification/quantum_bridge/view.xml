<signal name="N" label="Matrix rank N" digits="0" />
<signal name="L" label="Angular cutoff L" digits="0" />
<signal name="boundary_defect" label="Absolute lapse curvature, unit L2 cutoff harmonic" digits="7" better="lower" />
<signal name="interior_curvature" label="Curvature for fixed ell=1" digits="7" />
<signal name="lapse_block_rank" label="Axisymmetric lapse Hessian rank" digits="0" />
<signal name="constraint_residual" label="Vacuum constraint residual" digits="0" better="lower" />
<signal name="fd_error" label="Finite-difference absolute error" digits="12" better="lower" />
<signal name="quadrature_difference" label="Quadrature difference" digits="12" better="lower" />
<signal name="max_fd_error" label="Maximum derivative error" digits="12" better="lower" />
<signal name="checks_passed" label="Validated cases" digits="0" better="higher" />
<signal name="case" label="Quadrature case" />
<view headline="boundary_defect constraint_residual">
  <table name="cutoffs" columns="N boundary_defect interior_curvature lapse_block_rank" />
  <text>A nonzero lapse curvature is a constraint obstruction for the common finite-rank action. It is an expected scientific outcome, not a failed numerical run. The value is not a scattering amplitude.</text>
  <stats of="constraint_residual max_fd_error checks_passed" />
  <table name="quadrature" columns="case fd_error quadrature_difference" />
</view>
