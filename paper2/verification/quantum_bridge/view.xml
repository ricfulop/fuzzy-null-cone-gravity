<signal name="case" label="Case" />
<signal name="naive_curvature" label="Uncorrected lapse derivative" digits="8" />
<signal name="completed_curvature" label="Completed lapse derivative" digits="0" />
<signal name="quartic_correction" label="Required quartic correction" digits="8" />
<signal name="omitted_high_error" label="Error without high-block determinant" digits="8" />
<signal name="omitted_mixed_error" label="Error without mixed Schur terms" digits="8" />
<signal name="determinant_identity_residual" label="Exact determinant residual" digits="0" better="lower" />
<signal name="auxiliary_J" label="Auxiliary angular cutoff" digits="0" />
<signal name="epsilon" label="Lapse amplitude" />
<signal name="absolute_H" label="Remaining Hamiltonian magnitude" digits="12" better="lower" />
<signal name="quadrature_difference" label="Quadrature difference" digits="12" better="lower" />
<signal name="checks_passed" label="Validated cases" digits="0" better="higher" />
<view headline="completed_curvature determinant_identity_residual">
  <table name="completion" columns="case naive_curvature completed_curvature quartic_correction" />
  <text>This checks the gravitational angular kinetic restriction. A zero completed derivative validates this correction only; it is not a full graviton-loop amplitude or proof of nonlinear constraint closure.</text>
  <stats of="completed_curvature determinant_identity_residual checks_passed" />
  <table name="determinants" columns="case omitted_high_error omitted_mixed_error determinant_identity_residual" />
  <chart from="padding" x="auxiliary_J" y="absolute_H" by="epsilon" y-scale="log" ghost="false" />
</view>
